{
  "name": "vscode-sieve-formatter",
  "displayName": "Sieve Auto Formatter",
  "description": "Formats Sieve email filter scripts: removes trailing commas and expands multi-item lists to multi-line for cleaner git diffs",
  "repository": {
    "type": "git",
    "url": "git@github.com:brokenalarms/vscode-sieve-formatter.git"
  },
  "version": "0.1.0",
  "publisher": "brokenalarms",
  "categories": ["Formatters"],
  "keywords": ["sieve", "email", "filter", "protonmail", "formatter"],
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:sieve"
  ],
  "contributes": {
    "languages": [
      {
        "id": "sieve",
        "extensions": [".sieve"],
        "configuration": "./language-configuration.json"
      }
    ],
    "formatters": [
      {
        "language": "sieve",
        "provideDocumentFormattingEdits": true
      }
    ],
    "configuration": {
      "title": "Sieve Formatter",
      "properties": {
        "sieve.formatter.alwaysExpandRequire": {
          "type": "boolean",
          "default": false,
          "description": "Always expand the require statement to multi-line, even when it lists only one extension. Useful for keeping require consistently multi-line as rules grow."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc --watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "mocha --require ts-node/register 'src/test/**/*.test.ts'",
    "test:ci": "npm run lint && npm run compile && npm test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "mocha": "^10.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.6.3"
  }
}
